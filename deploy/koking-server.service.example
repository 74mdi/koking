[Unit]
Description=Koking self-hosted messaging API
After=network.target

[Service]
Type=simple
User=koking
Group=koking
WorkingDirectory=/var/lib/koking
Environment=KOKING_BIND=127.0.0.1:3000
Environment=KOKING_DATABASE_URL=sqlite:///var/lib/koking/koking.db?mode=rwc
Environment=KOKING_ALLOWED_ORIGINS=https://chat.example.com
Environment=RUST_LOG=info,tower_http=info
ExecStart=/usr/local/bin/koking-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/koking

[Install]
WantedBy=multi-user.target
