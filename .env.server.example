# Server defaults to loopback so it is not exposed before you choose a deployment.
KOKING_BIND=127.0.0.1:3000
KOKING_DATABASE_URL=sqlite://koking.db?mode=rwc
# Comma-separated exact browser origins. Include the web app's HTTPS origin in production.
KOKING_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
RUST_LOG=info,tower_http=info
